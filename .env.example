MANGAFLOW_ENVIRONMENT=development
MANGAFLOW_DEBUG=false
MANGAFLOW_CORS_ORIGINS=["http://localhost:5173"]
MANGAFLOW_MAX_UPLOAD_MB=100
MANGAFLOW_OCR_REVIEW_THRESHOLD=0.65
MANGAFLOW_TEXT_SEGMENTATION_ENABLED=true
# CUDA CTD uses the same FP32 weights. Enable after local quality/timing checks.
MANGAFLOW_SEGMENTATION_BACKEND=auto
MANGAFLOW_REPAIR_AUTO_RETRY=true
# Staged translation/repair rollout. Leave off until isolated acceptance passes.
MANGAFLOW_CHECKPOINT_PIPELINE_ENABLED=false
MANGAFLOW_PARALLEL_REPAIR_TRANSLATION=false
MANGAFLOW_CHECKPOINT_GC_ENABLED=false
MANGAFLOW_GPU_MAX_CONCURRENCY=1
MANGAFLOW_GPU_MEMORY_RESERVE_MB=2048
MANGAFLOW_TASK_CONCURRENCY=4
# Keep the unauthenticated local app private by default.
MANGAFLOW_BIND_HOST=127.0.0.1
MANGAFLOW_EXECUTION_MODE=auto
MANGAFLOW_CPU_WORKERS=4
MANGAFLOW_NATIVE_THREADS=2
MANGAFLOW_MEMORY_RESERVE_MB=1024
MANGAFLOW_MODEL_DIR=./models
MANGAFLOW_AUTO_PROVISION_MODELS=true
MANGAFLOW_MODEL_MANIFEST_PATH=./config.yaml
MANGAFLOW_ENVIRONMENT_FILE_PATH=./.env
# Required by the cloud-translation entry. Keep the example blank.
MANGAFLOW_TRANSLATION_API_KEY=
# Optional cloud multimodal OCR key, independent from translation.
MANGAFLOW_OCR_API_KEY=
# Docker GPU index/UUID; use all to expose every NVIDIA GPU.
MANGAFLOW_GPU_DEVICE=all
# Optional PostgreSQL override: docker-compose.postgres.yml (migrate first).
# Generate a private database password; never put it in this public template.
# MANGAFLOW_POSTGRES_PASSWORD=
# Set true only after migrating; scripts/docker.sh then includes the local PG service.
MANGAFLOW_LOCAL_POSTGRES=false
# Direct/non-Compose connection can use libpq's PGPASSWORD separately from URL.
# MANGAFLOW_DATABASE_URL=postgresql+psycopg://user@postgres:5432/mangaflow
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MANGAFLOW_SECRET_KEY=
# Maintenance startup blocks business requests and all background task recovery.
# Use only during migration verification; unset after successful checks.
MANGAFLOW_MAINTENANCE_MODE=false
