MANGAFLOW_ENVIRONMENT=development
MANGAFLOW_DEBUG=false
MANGAFLOW_CORS_ORIGINS=["http://localhost:5173"]
MANGAFLOW_MAX_UPLOAD_MB=100
MANGAFLOW_OCR_REVIEW_THRESHOLD=0.65
MANGAFLOW_TEXT_SEGMENTATION_ENABLED=true
MANGAFLOW_REPAIR_AUTO_RETRY=true
MANGAFLOW_TASK_CONCURRENCY=4
# Keep the unauthenticated local app private by default.
MANGAFLOW_BIND_HOST=127.0.0.1
MANGAFLOW_EXECUTION_MODE=auto
MANGAFLOW_CPU_WORKERS=4
MANGAFLOW_NATIVE_THREADS=2
MANGAFLOW_MEMORY_RESERVE_MB=1024
MANGAFLOW_MODEL_DIR=./models
MANGAFLOW_AUTO_PROVISION_MODELS=true
MANGAFLOW_MODEL_MANIFEST_PATH=./config.yaml
MANGAFLOW_ENVIRONMENT_FILE_PATH=./.env
# Required by the cloud-translation entry. Keep the example blank.
MANGAFLOW_TRANSLATION_API_KEY=
# Optional cloud multimodal OCR key, independent from translation.
MANGAFLOW_OCR_API_KEY=
# Docker GPU index/UUID; use all to expose every NVIDIA GPU.
MANGAFLOW_GPU_DEVICE=all
# MANGAFLOW_DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/mangaflow
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MANGAFLOW_SECRET_KEY=
