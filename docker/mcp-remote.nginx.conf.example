# Separate TLS ingress for agents only. Keep MangaFlow's normal app bound to
# loopback; never proxy /api or /media on this public virtual host.
# /mangaflow/setup, setup.json, install.mjs and connector.tgz are fixed public
# bootstrap files without credentials or project data. Business calls and
# transfers under the same prefix retain MCP authentication and Host/Origin checks.
server {
    listen 443 ssl;
    server_name manga.example.com;
    ssl_certificate /etc/letsencrypt/live/manga.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/manga.example.com/privkey.pem;
    client_max_body_size 1025m;
    location ~ ^/(mangaflow|mcp)(/|$) {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_request_buffering off;
        proxy_send_timeout 300s;
    }
    location / { return 404; }
}
